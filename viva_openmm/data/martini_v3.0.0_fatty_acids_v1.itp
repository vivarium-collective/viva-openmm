[moleculetype]
  FA12M         1

[atoms]
   1  Q5     1  FA12M  COO   1  -1.0
   2  C1     1  FA12M  C1A   2   0.0
   3  C1     1  FA12M  C2A   3   0.0
   4  C1     1  FA12M  C3A   4   0.0

[bonds]
   1  2  1  0.47  5000
   2  3  1  0.47  3800
   3  4  1  0.47  3800

[angles]
   1  2  3  2  180.0  35.0
   2  3  4  2  180.0  35.0

; --- C14:0 tetradecanoate (myristate), deprotonated ---
[moleculetype]
  FA14M         1

[atoms]
   1  Q5     1  FA14M  COO   1  -1.0
   2  C1     1  FA14M  C1A   2   0.0
   3  C1     1  FA14M  C2A   3   0.0
   4  C1     1  FA14M  C3A   4   0.0

[bonds]
   1  2  1  0.47  5000
   2  3  1  0.47  3800
   3  4  1  0.47  3800

[angles]
   1  2  3  2  180.0  35.0
   2  3  4  2  180.0  35.0

; --- C16:0 hexadecanoate (palmitate), deprotonated ---
[moleculetype]
  FA16M         1

[atoms]
   1  Q5     1  FA16M  COO   1  -1.0
   2  C1     1  FA16M  C1A   2   0.0
   3  C1     1  FA16M  C2A   3   0.0
   4  C1     1  FA16M  C3A   4   0.0
   5  C1     1  FA16M  C4A   5   0.0

[bonds]
   1  2  1  0.47  5000
   2  3  1  0.47  3800
   3  4  1  0.47  3800
   4  5  1  0.47  3800

[angles]
   1  2  3  2  180.0  35.0
   2  3  4  2  180.0  35.0
   3  4  5  2  180.0  35.0
